{
  "name": "radman",
  "version": "1.1.0",
  "description": "Lightweight, zero-network-request crypto donation modal library (QR + address display)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "sample": "node sample/serve.js",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "radman",
    "crypto",
    "donation",
    "modal",
    "qr-code",
    "bitcoin",
    "ethereum",
    "solana",
    "ton",
    "vanilla-js"
  ],
  "author": "Parsa Taheri",
  "homepage": "https://radman.garothmana.ir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/par-taheri/radman.git"
  },
  "bugs": {
    "url": "https://github.com/par-taheri/radman/issues"
  },
  "license": "MIT",
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "terser": "^5.44.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
